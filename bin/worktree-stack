#!/usr/bin/env bash
#
# worktree-stack — run an isolated Docker Compose stack for the current git
# worktree, so a feature branch can be tested independently of `main` and of
# other worktrees running at the same time.
#
# Each linked worktree gets:
#   * its own COMPOSE_PROJECT_NAME  → namespaced containers, network, volumes
#     (data is isolated: ged-<slug>_pgdata / _oauth_data / _storage)
#   * distinct host ports           → GED_WEB_PORT / GED_OAUTH_PORT / GED_DB_PORT
#     (plus GED_GRAFANA_PORT / GED_OTLP_PORT for the optional otel profile),
#     derived deterministically from the worktree directory name so they're stable
#
# docker-compose.yml publishes "${GED_WEB_PORT:-3000}:80",
# "${GED_OAUTH_PORT:-9292}:9292", and "${GED_DB_PORT:-5432}:5432", so run from
# the primary tree this is just the normal stack on 3000 / 9292 / 5432.
#
# Observability: GED_OTEL=1 enables the "otel" compose profile (grafana/otel-lgtm
# backend) and points the app's OTLP export at it, e.g.
#   GED_OTEL=1 bin/worktree-stack up
# Grafana is published on GED_GRAFANA_PORT (base 3300) and the collector's OTLP
# http port on GED_OTLP_PORT (base 4318, for host-native `ged serve` exports).
#
# The published Postgres port is how host-native `cargo test` reaches this
# worktree's database. `db-port` prints it. Each worktree runs against its own
# isolated Postgres (no shared Homebrew PG, no cross-worktree migration clashes).
#
# The stack is Rust: one image, `ged serve` on web and `ged worker` on worker.
# `GED_STACK`, when set, must be `rust`. Commands after `up` (exec, seed,
# scale, logs, down) follow the stack `up` remembered, unless GED_STACK is
# set again. `clean` forgets that name. `active` prints `rust` and nothing
# else: GED_STACK if set, else the name `up` remembered, else rust. A
# remembered name other than rust is an error.
#
# Usage:
#   bin/worktree-stack up [--scale worker=N]
#                                   build + start the full stack (detached);
#                                   --build may recreate containers when the
#                                   build context changed — for a pure hot
#                                   scale use `scale` below
#   bin/worktree-stack scale N      hot-scale to N worker replicas (no build,
#                                   no recreate: web + existing workers stay
#                                   untouched; surplus replicas drain + stop)
#   bin/worktree-stack db           start ONLY Postgres, wait until healthy
#                                   (the host-native cargo test loop)
#   bin/worktree-stack db-port      print this worktree's host Postgres port
#   bin/worktree-stack seed         create the admin user (first boot only):
#                                   `ged seed`
#   bin/worktree-stack active       print rust (GED_STACK, else the name `up`
#                                   remembered, else rust)
#   bin/worktree-stack down [-v]    stop + remove containers (-v also volumes)
#   bin/worktree-stack clean        full ménage: down -v, remove built images,
#                                   and forget the remembered stack name
#   bin/worktree-stack <cmd> ...    passthrough to `docker compose` (ps, logs…)
#
# Ports collide only if two worktree slugs hash to the same offset; override
# with GED_WEB_PORT / GED_OAUTH_PORT / GED_DB_PORT if that ever happens.
#
# Differential fuzz can run a second compose project beside this worktree's
# stack (a Rails checkout of the tag `rails-final` is a separate worktree).
# Set GED_COMPOSE_PROJECT to that project name. Also set GED_STACK=rust and
# explicit GED_WEB_PORT, GED_OAUTH_PORT and GED_DB_PORT: without them,
# `clean`/`scale`/`exec` would follow the stack this worktree remembers, and
# the default ports would collide with it. `up` does not replace the stack
# name this worktree remembers, and `clean` does not forget it either.
set -euo pipefail

cd "$(dirname "$0")/.."
ROOT="$PWD"

git_dir=$(cd "$(git rev-parse --git-dir)" && pwd -P)
git_common=$(cd "$(git rev-parse --git-common-dir)" && pwd -P)

slug=$(basename "$ROOT" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9-' '-' \
       | sed -E 's/-+/-/g; s/^-//; s/-$//')

# Checked before the port defaults below, so a side project cannot silently
# reuse this worktree's ports or the stack name `up` remembered.
if [ -n "${GED_COMPOSE_PROJECT:-}" ]; then
  case "${GED_STACK:-}" in
    rust) ;;
    *)
      echo "GED_COMPOSE_PROJECT is set: export GED_STACK=rust" >&2
      exit 1
      ;;
  esac
  if [ -z "${GED_WEB_PORT:-}" ] || [ -z "${GED_OAUTH_PORT:-}" ] || [ -z "${GED_DB_PORT:-}" ]; then
    echo "GED_COMPOSE_PROJECT is set: export GED_WEB_PORT, GED_OAUTH_PORT and GED_DB_PORT" >&2
    exit 1
  fi
fi

if [ "$git_dir" != "$git_common" ]; then
  # Linked worktree: isolate project + ports from everything else.
  project="ged-$slug"
  offset=$(( ( $(printf '%s' "$slug" | cksum | cut -d' ' -f1) % 250 ) + 1 ))
  web_port="${GED_WEB_PORT:-$((3000 + offset))}"
  oauth_port="${GED_OAUTH_PORT:-$((9292 + offset))}"
  db_port="${GED_DB_PORT:-$((5432 + offset))}"
  grafana_port="${GED_GRAFANA_PORT:-$((3300 + offset))}"
  otlp_port="${GED_OTLP_PORT:-$((4318 + offset))}"
else
  # Primary tree: the normal stack on the default ports.
  project="${COMPOSE_PROJECT_NAME:-ged}"
  web_port="${GED_WEB_PORT:-3000}"
  oauth_port="${GED_OAUTH_PORT:-9292}"
  db_port="${GED_DB_PORT:-5432}"
  grafana_port="${GED_GRAFANA_PORT:-3300}"
  otlp_port="${GED_OTLP_PORT:-4318}"
fi

# Side project for differential fuzz. Ports stay the caller's override.
if [ -n "${GED_COMPOSE_PROJECT:-}" ]; then
  project="$GED_COMPOSE_PROJECT"
fi

export COMPOSE_PROJECT_NAME="$project"
export GED_WEB_PORT="$web_port"
export GED_OAUTH_PORT="$oauth_port"
export GED_DB_PORT="$db_port"
export GED_GRAFANA_PORT="$grafana_port"
export GED_OTLP_PORT="$otlp_port"

# GED_OTEL=1 → activate the otel-lgtm backend and point the app at it.
# The endpoint is container-to-container (compose network), so no port offset.
if [ "${GED_OTEL:-0}" = "1" ]; then
  export COMPOSE_PROFILES="${COMPOSE_PROFILES:+$COMPOSE_PROFILES,}otel"
  export GED_OTEL_ENDPOINT="${GED_OTEL_ENDPOINT:-http://otel-lgtm:4318}"
fi

# Compose reads .env from the project dir for SECRET_KEY_BASE / GED_ADMIN_PASSWORD,
# but .env is gitignored so a fresh worktree has none. Reuse the primary tree's
# secrets if present, otherwise generate a throwaway .env for this worktree.
ensure_env() {
  [ -f "$ROOT/.env" ] && return 0
  local main_env="$(dirname "$git_common")/.env"
  if [ -f "$main_env" ] && [ "$main_env" != "$ROOT/.env" ]; then
    cp "$main_env" "$ROOT/.env"
    echo "→ copied secrets from $main_env"
  else
    printf 'SECRET_KEY_BASE=%s\nGED_ADMIN_PASSWORD=changeme\n' \
      "$(openssl rand -hex 64)" > "$ROOT/.env"
    echo "→ generated $ROOT/.env (GED_ADMIN_PASSWORD=changeme)"
  fi
}

# Remembers which image `up` started so later exec/seed/scale hit that stack.
stack_state_file() {
  printf '%s/ged-worktree-stack-%s\n' "${TMPDIR:-/tmp}" "$slug"
}

remember_stack() {
  printf '%s\n' "$1" > "$(stack_state_file)"
}

active_stack() {
  if [ -n "${GED_STACK:-}" ]; then
    printf '%s\n' "$GED_STACK"
    return
  fi
  local f
  f="$(stack_state_file)"
  if [ -f "$f" ]; then
    tr -d '[:space:]' < "$f"
    return
  fi
  printf '%s\n' rust
}

# Print only rust. Same choice as active_stack. Anything else, including a
# remembered rails name from before T16, is rejected.
print_active_stack() {
  local stack
  stack="$(active_stack)"
  case "$stack" in
    rust)
      printf '%s\n' "$stack"
      ;;
    *)
      echo "GED_STACK=$stack: expected rust" >&2
      return 1
      ;;
  esac
}

compose_as() {
  local stack="$1"
  shift
  ensure_env
  case "$stack" in
    rust)
      docker compose -f "$ROOT/docker-compose.yml" "$@"
      ;;
    *)
      echo "GED_STACK=$stack: expected rust" >&2
      exit 1
      ;;
  esac
}

urls() {
  cat <<EOF

  Admin UI   http://localhost:$web_port
  API docs   http://localhost:$web_port/api/docs
  OpenAPI    http://localhost:$web_port/api/v1/openapi.yaml
  OAuth      http://localhost:$oauth_port/token
EOF
  if [[ ",${COMPOSE_PROFILES:-}," == *",otel,"* ]]; then
    cat <<EOF
  Grafana    http://localhost:$grafana_port
  OTLP http  http://localhost:$otlp_port  (for host-native exports)
EOF
  fi
}

cmd="${1:-help}"
shift || true

case "$cmd" in
  up)
    # Unset GED_STACK means Rust, even if a previous `up` remembered another name.
    stack="${GED_STACK:-rust}"
    echo "▶ project=$COMPOSE_PROJECT_NAME  stack=$stack  web=$web_port  oauth=$oauth_port  db=$db_port"
    compose_as "$stack" up --build -d "$@"
    # A side project must not become the stack `active` reports.
    if [ -z "${GED_COMPOSE_PROJECT:-}" ]; then
      remember_stack "$stack"
    fi
    urls
    echo
    echo "  First boot only — create the admin user:"
    echo "    bin/worktree-stack seed"
    ;;
  scale)
    # Hot-scale worker replicas: adds/removes ONLY worker containers, never
    # rebuilds nor recreates anything (unlike `up --scale`, whose --build
    # recreates web whenever the build context changed). Surplus replicas
    # get SIGTERM and drain in-flight jobs (stop_grace_period).
    compose_as "$(active_stack)" up -d --no-build --no-recreate \
      --scale "worker=${1:?usage: bin/worktree-stack scale N}" worker
    ;;
  db)
    # Start only Postgres for the host-native dev/test loop and wait until it
    # accepts connections (`up -d` returns before the healthcheck passes).
    # ensure_env is required: Compose interpolates the whole file even for a
    # single service, so web's ${SECRET_KEY_BASE:?} aborts a .env-less start.
    compose_as "$(active_stack)" up -d postgres
    printf '▶ postgres on host port %s — waiting' "$db_port"
    until compose_as "$(active_stack)" exec -T postgres pg_isready -U "${GED_DB_USER:-postgres}" >/dev/null 2>&1; do
      printf '.'
      sleep 1
    done
    echo ' ready'
    ;;
  db-port)
    # Print only the host Postgres port, for host-native tests.
    echo "$db_port"
    ;;
  seed)
    compose_as "$(active_stack)" exec -T web ged seed
    ;;
  active)
    print_active_stack
    ;;
  down)
    compose_as "$(active_stack)" down "$@"
    ;;
  clean)
    compose_as "$(active_stack)" down -v --rmi local "$@"
    # The side project has its own containers; the remembered name belongs
    # to this worktree's primary stack.
    if [ -z "${GED_COMPOSE_PROJECT:-}" ]; then
      rm -f "$(stack_state_file)"
    fi
    ;;
  urls|url)
    echo "▶ project=$COMPOSE_PROJECT_NAME  stack=$(active_stack)  web=$web_port  oauth=$oauth_port  db=$db_port"
    urls
    ;;
  help|-h|--help)
    # Print the leading comment block (from line 3) as usage text.
    awk 'NR>2 && /^#/ { sub(/^# ?/, ""); print; next } NR>2 { exit }' "$0"
    ;;
  *)
    # Passthrough: any other docker compose subcommand (ps, logs, exec, …)
    # with this worktree's project + ports already exported.
    compose_as "$(active_stack)" "$cmd" "$@"
    ;;
esac
