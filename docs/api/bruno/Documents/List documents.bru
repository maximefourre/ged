meta {
  name: List documents
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/documents
  body: none
  auth: bearer
}

params:query {
  ~department_id: {{departmentId}}
  ~filename: invoice
  ~tag: type
  ~tag_value: facture
  ~limit: 100
  ~offset: 0
}

auth:bearer {
  token: {{token}}
}

docs {
  Lists accessible documents, newest first. Enable any of the disabled query
  params to filter. `tag_value` requires `tag`.

  Response is an envelope: `{ documents: [...], pagination: { limit, offset, total } }`.
  `limit` and `offset` are the effective applied values (after clamping).
  `total` is the count of all matches ignoring the pagination window.
}
