<h1>Upload requests</h1>
<p>
  Upload queue:
  <% if @queue_paused %>
    <strong>paused</strong>
    <%= button_to "Resume", admin_upload_queue_pause_path, method: :delete %>
  <% else %>
    active
    <%= button_to "Pause", admin_upload_queue_pause_path, method: :post %>
  <% end %>
  — <%= @pending_count %> pending, <%= @processing_count %> processing
</p>
<%= form_with url: admin_upload_requests_path, method: :get do |f| %>
  <%= f.select :status,
        options_for_select(UploadRequest::STATUSES, params[:status]),
        include_blank: "all statuses" %>
  <%= f.submit "Filter" %>
<% end %>
<table>
  <tr><th>Request</th><th>Department</th><th>Filename</th><th>Tags</th><th>Status</th><th>Error</th><th>Uploaded by</th><th>Date</th></tr>
  <% @upload_requests.each do |request| %>
    <tr>
      <td><%= request.id %></td>
      <td><%= request.department.name %></td>
      <td><%= request.filename %></td>
      <td><%= format_tags(request.tags) %></td>
      <td><%= request.status %></td>
      <td><%= request.error_message %></td>
      <td><%= request.uploaded_by %></td>
      <td><%= request.created_at.strftime("%Y-%m-%d %H:%M") %></td>
    </tr>
  <% end %>
</table>
<%= render "admin/shared/pagination" %>
