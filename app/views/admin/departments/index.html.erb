<h1>Departments</h1>
<%= link_to "New department", new_admin_department_path %>
<table>
  <tr><th>Name</th><th>Parent</th><th></th></tr>
  <% @departments.each do |dept| %>
    <tr>
      <td><%= dept.name %></td>
      <td><%= dept.parent&.name %></td>
      <td>
        <%= link_to "Rename", edit_admin_department_path(dept) %>
        <%= button_to "Delete", admin_department_path(dept), method: :delete,
            data: { turbo_confirm: "Delete #{dept.name}?" } %>
      </td>
    </tr>
  <% end %>
</table>
