<header class="page-head">
  <h1>Departments</h1>
  <%= link_to "New department", new_admin_department_path, class: "btn btn-primary" %>
</header>

<div class="card">
  <div class="table-wrap">
    <table class="tbl">
      <thead>
        <tr><th>Name</th><th>Documents</th><th></th></tr>
      </thead>
      <tbody>
        <% @department_pairs.each do |dept, depth| %>
          <tr<%= ' class="trashed"'.html_safe if dept.deleted_at? %> data-dept-id="<%= dept.id %>"<% if dept.parent_id %> data-parent-id="<%= dept.parent_id %>"<% end %>>
            <td class="strong">
              <% if @parent_ids.include?(dept.id) %>
                <% if depth > 0 %><span class="tree-guide"><%= " " * 3 * (depth - 1) %></span><% end %><button type="button" class="tree-toggle" data-tree-toggle aria-expanded="true" aria-label="Replier <%= dept.name %>">▾</button>
              <% elsif depth > 0 %>
                <span class="tree-guide"><%= " " * 3 * (depth - 1) %>└─ </span>
              <% end %>
              <%= dept.name %>
            </td>
            <td><%= dept.deleted_at? ? @trashed_counts.fetch(dept.id, 0) : @doc_counts.fetch(dept.id, 0) %></td>
            <td>
              <div class="row-actions">
                <% if dept.deleted_at? %>
                  <%= button_to "Restore", restore_admin_department_path(dept), method: :patch, class: "btn btn-sm" %>
                <% else %>
                  <%= link_to "Rename", edit_admin_department_path(dept), class: "btn btn-link btn-sm" %>
                  <%= button_to "Delete", admin_department_path(dept), method: :delete,
                      class: "btn btn-danger btn-sm",
                      data: { confirm: "Delete #{dept.name}?" } %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
        <% if @department_pairs.empty? %>
          <tr><td colspan="3" class="empty">No departments yet.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
