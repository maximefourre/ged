<header class="page-head">
  <h1>Trash</h1>
</header>

<p class="muted">Deleted documents are kept for 30 days, then permanently purged.
  Restore one to bring it back into Documents.</p>

<div class="card">
  <div class="table-wrap">
    <table class="tbl">
      <thead>
        <tr><th>Filename</th><th>Department</th><th>Tags</th><th>Deleted</th><th>Purges on</th><th></th></tr>
      </thead>
      <tbody>
        <% @documents.each do |doc| %>
          <tr>
            <td class="strong"><%= doc.filename %></td>
            <td>
              <% dept = @departments_by_id[doc.department_id] %>
              <%= dept&.name %><% if dept&.deleted_at? %> <span class="muted">(trashed)</span><% end %>
            </td>
            <td><%= render "admin/shared/tag_chips", tags: doc.tags %></td>
            <td class="date"><%= doc.deleted_at.strftime("%Y-%m-%d %H:%M") %></td>
            <td class="date"><%= doc.purge_at.strftime("%Y-%m-%d") %></td>
            <td>
              <div class="row-actions">
                <%= button_to "Restore", restore_admin_deleted_document_path(doc), method: :patch,
                    class: "btn btn-sm" %>
              </div>
            </td>
          </tr>
        <% end %>
        <% if @documents.empty? %>
          <tr><td colspan="6" class="empty">Trash is empty.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<%= render "admin/shared/pagination" %>
