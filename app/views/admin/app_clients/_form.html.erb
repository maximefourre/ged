<%= form_with model: [ :admin, @app_client ], class: "form-card" do |f| %>
  <div class="field">
    <%= f.label :client_identifier %>
    <%= f.text_field :client_identifier, class: "input" %>
  </div>
  <div class="field">
    <%= f.label :description %>
    <%= f.text_field :description, class: "input" %>
  </div>
  <div class="field">
    <span class="field-label">Department access</span>
    <div class="table-wrap">
      <table class="tbl">
        <thead>
          <tr><th>Department</th><th>Read</th><th>Write</th></tr>
        </thead>
        <tbody>
          <% @departments.each do |department| %>
            <% access = @app_client.client_department_accesses
                                   .detect { |a| a.department_id == department.id } %>
            <tr>
              <td><%= department.name %><% if department.deleted_at? %> <span class="muted">(trashed)</span><% end %></td>
              <td>
                <%= hidden_field_tag "app_client[access][#{department.id}][read]", "0", id: nil %>
                <%= check_box_tag "app_client[access][#{department.id}][read]", "1",
                                  access&.can_read? %>
              </td>
              <td>
                <%= hidden_field_tag "app_client[access][#{department.id}][write]", "0", id: nil %>
                <%= check_box_tag "app_client[access][#{department.id}][write]", "1",
                                  access&.can_write? %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
  <div class="form-actions">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", admin_app_clients_path, class: "btn" %>
  </div>
<% end %>
