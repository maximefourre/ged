<header class="page-head">
  <h1>Tags — <%= @document.filename %></h1>
</header>

<section class="card meta-card">
  <dl class="meta-list">
    <div><dt>Uploaded</dt><dd class="mono"><%= @document.uploaded_at.strftime("%Y-%m-%d %H:%M") %></dd></div>
    <div><dt>Indexed</dt><dd class="mono"><%= @document.created_at.strftime("%Y-%m-%d %H:%M") %></dd></div>
    <div><dt>Updated</dt><dd class="mono"><%= @document.updated_at.strftime("%Y-%m-%d %H:%M") %></dd></div>
    <div><dt>Upload mode</dt><dd><%= @document.upload_mode %></dd></div>
    <div><dt>Owner</dt><dd><%= @document.uploaded_by %></dd></div>
  </dl>
</section>

<%= form_with model: [ :admin, @document ], class: "form-card" do |f| %>
  <div class="field">
    <%= label_tag "document[tags_text]", "Tags" %>
    <span class="hint">Une paire <code>key=value</code> par ligne ; une ligne sans « = » est une clé sans valeur.</span>
    <%= text_area_tag "document[tags_text]", tags_text(@document.tags), rows: 8, class: "input" %>
  </div>
  <div class="form-actions">
    <%= f.submit "Save tags", class: "btn btn-primary" %>
    <%= link_to "Back to documents", admin_documents_path, class: "btn" %>
  </div>
<% end %>
