<h1>Upload document</h1>
<%= form_with model: [ :admin, @document ] do |f| %>
  <div><%= f.label :department_id %>
    <%= f.collection_select :department_id, Department.order(:name), :id, :name %></div>
  <div><%= f.label :file %> <%= f.file_field :file %></div>
  <%= f.submit "Upload" %>
<% end %>
